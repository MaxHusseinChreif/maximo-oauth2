OAUTH_CLIENT_ID=maximo-client
OAUTH_CLIENT_SECRET=
MAXIMO_SCRIPT_BASE_URL=https://maximo.example.com/maximo/api/script
MAXIMO_API_KEY=
JWT_PRIVATE_KEY_FILE=./secrets/private-key.pem
JWT_PUBLIC_KEY_FILE=./secrets/public-key.pem
JWT_ISSUER=maximo-oauth2
JWT_AUDIENCE=maximo-api
JWT_KEY_ID=maximo-oauth2-primary
JWT_EXPIRATION_SECONDS=1800
# Local Docker uses HTTP. Keep this true in OpenShift (the application default).
REQUIRE_HTTPS=false
